{
  "name": "compass",
  "pages_build_output_dir": "client/dist",
  "compatibility_date": "2026-08-01",

  // Respostas anonimas, so para os numeros de comparacao que aparecem no
  // resultado. Nada aqui identifica quem respondeu: ver migrations/0001_init.sql.
  //
  // Producao. O de desenvolvimento fica no bloco `env.preview` abaixo, que e o
  // que os comandos com `--env preview` usam.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compass-db",
      "database_id": "b4756ff2-ecf7-4938-bbab-9db7a14355b8"
    }
  ],

  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "compass-db-dev",
          "database_id": "74f18768-166f-4c59-a153-4e5490864f6b"
        }
      ]
    }
  }
}
